# Whitelist. Every path is ignored unless re-included below.

*
!/.gitignore
!/Makefile
!/meson.build
!/meson_options.txt
!/README.md
!/LICENSE
!/NOTICE
!/CREDITS.md
!/VERSION
!/EGM.md
!/.clang-format
!/.clang-tidy
!/.clangd
!/.editorconfig
!/.gitattributes

!/include/
!/include/rice-ini/
!/include/rice-ini/*.h

!/src/
!/src/*.c

!/tests/
!/tests/meson.build
!/tests/*.c
!/tests/*.cpp
!/tests/*.sh
